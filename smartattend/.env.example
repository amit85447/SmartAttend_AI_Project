# Copy this file to ".env" (same folder) and edit. Lines starting with # are comments.
# Quick test database (no MySQL needed). Remove this line when you switch to MySQL:
SMARTATTEND_DB_URL=sqlite:///smartattend_dev.db
# MySQL (replace USER, PASSWORD):
# SMARTATTEND_DB_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/smartattend
# Encryption key for face data. Create with:  python make_key.py   then paste the output here
# SMARTATTEND_KEY=
FACE_MATCH_THRESHOLD=0.60
LIVENESS_REQUIRED=1
MAX_GPS_ACCURACY_M=100
